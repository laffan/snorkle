{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "chrome",
  "description": "Browser chrome: the bundled local UI in the webview labelled \"main\". No remote origins, no other webviews. SECURITY-REVIEW: every change here needs human sign-off.",
  "local": true,
  "windows": [],
  "webviews": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-state",
    "allow-navigate",
    "allow-new-tab",
    "allow-close-tab",
    "allow-activate-tab",
    "allow-go-back",
    "allow-go-forward",
    "allow-reload",
    "allow-stop",
    "allow-proceed-http",
    "allow-confirm-external",
    "allow-dismiss-notice",
    "allow-set-chrome-layout",
    "allow-list-bookmarks",
    "allow-toggle-bookmark",
    "allow-remove-bookmark",
    "allow-list-history",
    "allow-clear-history",
    "allow-toggle-site-adblock",
    "allow-bookmark-tab",
    "allow-move-bookmark",
    "allow-split-tabs",
    "allow-unsplit",
    "allow-get-view-mode",
    "allow-set-view-mode",
    "allow-set-tab-view-exempt",
    "allow-set-tab-headers",
    "allow-get-headings",
    "allow-find-in-page",
    "allow-count-in-page",
    "allow-end-find",
    "allow-focus-chrome",
    "allow-share-page",
    "allow-read-selection",
    "allow-define-term",
    "allow-search-google",
    "allow-get-shortcuts",
    "allow-set-shortcuts",
    "allow-ai-chat",
    "allow-list-chats",
    "allow-get-chat",
    "allow-delete-chat",
    "allow-scroll-to-heading",
    "allow-clear-website-data",
    "allow-ai-status",
    "allow-ai-set-key",
    "allow-ai-delete-key",
    "allow-ai-test",
    "allow-ai-write-script",
    "allow-detect-headings",
    "allow-ai-usage",
    "allow-ai-reset-usage",
    "allow-open-launcher",
    "allow-get-console",
    "allow-set-console-capture",
    "allow-clear-console",
    "allow-list-user-scripts",
    "allow-save-user-script",
    "allow-delete-user-script",
    "allow-list-pins",
    "allow-pin-tab",
    "allow-pin-bookmark",
    "allow-move-pin",
    "allow-unpin"
  ]
}
