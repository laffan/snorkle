{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "chrome",
  "description": "Browser chrome: the bundled local UI in the webview labelled \"main\". No remote origins, no other webviews. SECURITY-REVIEW: every change here needs human sign-off.",
  "local": true,
  "windows": [],
  "webviews": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "allow-get-state",
    "allow-navigate",
    "allow-new-tab",
    "allow-close-tab",
    "allow-activate-tab",
    "allow-go-back",
    "allow-go-forward",
    "allow-reload",
    "allow-stop",
    "allow-proceed-http",
    "allow-confirm-external",
    "allow-dismiss-notice",
    "allow-set-chrome-layout",
    "allow-list-bookmarks",
    "allow-toggle-bookmark",
    "allow-remove-bookmark",
    "allow-list-history",
    "allow-clear-history",
    "allow-remove-history",
    "allow-search-history",
    "allow-get-page-text",
    "allow-reopen-closed-tab",
    "allow-list-downloads",
    "allow-cancel-download",
    "allow-delete-download",
    "allow-clear-downloads",
    "allow-export-download",
    "allow-share-download",
    "allow-answer-download-prompt",
    "allow-toggle-site-adblock",
    "allow-bookmark-tab",
    "allow-move-bookmark",
    "allow-split-tabs",
    "allow-unsplit",
    "allow-split-new",
    "allow-set-split-ratio",
    "allow-get-view-mode",
    "allow-set-view-mode",
    "allow-set-launch-mode",
    "allow-set-tab-view-exempt",
    "allow-set-tab-headers",
    "allow-get-headings",
    "allow-find-in-page",
    "allow-end-find",
    "allow-focus-chrome",
    "allow-set-appearance",
    "allow-share-page",
    "allow-image-action",
    "allow-zoom-page",
    "allow-set-url-bar-attached",
    "allow-read-selection",
    "allow-define-term",
    "allow-search-google",
    "allow-get-shortcuts",
    "allow-set-shortcuts",
    "allow-ai-chat",
    "allow-ai-efforts",
    "allow-list-chats",
    "allow-get-chat",
    "allow-delete-chat",
    "allow-scroll-to-heading",
    "allow-clear-website-data",
    "allow-ai-status",
    "allow-ai-set-key",
    "allow-ai-delete-key",
    "allow-ai-test",
    "allow-ai-write-script",
    "allow-detect-headings",
    "allow-ai-usage",
    "allow-ai-reset-usage",
    "allow-open-launcher",
    "allow-get-console",
    "allow-set-console-capture",
    "allow-clear-console",
    "allow-list-user-scripts",
    "allow-save-user-script",
    "allow-delete-user-script",
    "allow-list-pins",
    "allow-pin-tab",
    "allow-pin-bookmark",
    "allow-move-pin",
    "allow-unpin",
    "allow-set-pin-emoji",
    "allow-edit-item-url",
    "allow-get-blocked",
    "allow-add-blocked",
    "allow-block-site",
    "allow-edit-blocked",
    "allow-set-blocked-message",
    "allow-tab-icons",
    "allow-set-swipe-navigation",
    "allow-set-open-app-links",
    "allow-open-in-app",
    "allow-save-for-later",
    "allow-list-later",
    "allow-restore-later",
    "allow-bookmark-later",
    "allow-delete-later",
    "allow-set-pull-to-refresh",
    "allow-move-tab",
    "allow-set-tab-label",
    "allow-open-later",
    "allow-add-later-pages",
    "allow-finish-adding-pages",
    "allow-cancel-adding-pages"
  ]
}
