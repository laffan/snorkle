<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Merged by the Tauri CLI into the generated iOS Info.plist.
  SECURITY-REVIEW: every key here needs human sign-off.
-->
<plist version="1.0">
<dict>
  <!-- Image menu → Share Image: the share sheet's "Save Image" adds the
       image to Photos, which iOS refuses (terminating the app) without a
       purpose string. Add-only access; the app never reads the library. -->
  <key>NSPhotoLibraryAddUsageDescription</key>
  <string>Save images from web pages to your photo library when you choose Save Image.</string>
  <!-- Default-browser requirement: declare the http and https schemes. -->
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLName</key>
      <string>Web site URL</string>
      <key>CFBundleURLSchemes</key>
      <array>
        <string>http</string>
        <string>https</string>
      </array>
    </dict>
  </array>
  <!--
    ATS: allow plain-HTTP loads *inside web content only*, so the user can
    explicitly continue to an HTTP-only site after the HTTPS-first
    interstitial. The app's own networking (there is none) stays under ATS.
    No NSAllowsArbitraryLoads.
  -->
  <key>NSAppTransportSecurity</key>
  <dict>
    <key>NSAllowsArbitraryLoadsInWebContent</key>
    <true/>
  </dict>
  <!-- Camera/microphone prompts for web pages (getUserMedia). -->
  <key>NSCameraUsageDescription</key>
  <string>Websites you visit can ask to use the camera. You will be asked each time.</string>
  <key>NSMicrophoneUsageDescription</key>
  <string>Websites you visit can ask to use the microphone. You will be asked each time.</string>
  <key>UISupportsDocumentBrowser</key>
  <false/>
</dict>
</plist>
